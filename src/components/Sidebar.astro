---
import { getCollection } from "astro:content";
import { bubbleStyle } from "../lib/palette";

const lessons = (await getCollection("lessons")).sort((a, b) => a.data.order - b.data.order);
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---
<nav class="text-sm">
  <a
    href="/"
    class={`block rounded-xl px-3 py-2 text-white font-medium shadow-sm transition-all hover:brightness-110 hover:shadow-md ${
      currentPath === "" ? "ring-2 ring-white/80 dark:ring-white/50" : ""
    }`}
    style="background-image: linear-gradient(135deg, #e8672f 0%, #c1440e 100%);"
  >
    Home
  </a>

  <p class="px-3 mt-5 mb-1 text-xs font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500">
    Lessons
  </p>
  <ul class="space-y-1.5">
    {lessons.map((lesson, i) => {
      const href = `/lessons/${lesson.id}`;
      const active = currentPath === href;
      return (
        <li>
          <a
            href={href}
            data-lesson-link={lesson.id}
            class={`flex items-center gap-2.5 rounded-xl px-2.5 py-2 text-white font-medium shadow-sm transition-all hover:brightness-110 hover:shadow-md ${
              active ? "ring-2 ring-white/80 dark:ring-white/50" : ""
            }`}
            style={bubbleStyle(i)}
          >
            <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/20 text-[11px] font-bold">
              {i + 1}
            </span>
            <span class="flex-1 leading-tight">{lesson.data.title}</span>
            <span data-lesson-check={lesson.id} class="hidden text-xs">✓</span>
          </a>
        </li>
      );
    })}
  </ul>

  <p class="px-3 mt-5 mb-1 text-xs font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500">
    Reference
  </p>
  <ul class="space-y-0.5">
    <li>
      <a
        href="/cheatsheet"
        class={`block rounded-md px-3 py-2 transition-colors ${
          currentPath === "/cheatsheet" ? "bg-brand/10 text-brand-dark dark:bg-brand/15 dark:text-brand-light font-medium" : "text-stone-600 dark:text-stone-300 hover:bg-stone-200/60 dark:hover:bg-stone-800"
        }`}
      >
        Cheatsheet
      </a>
    </li>
    <li>
      <a
        href="/about"
        class={`block rounded-md px-3 py-2 transition-colors ${
          currentPath === "/about" ? "bg-brand/10 text-brand-dark dark:bg-brand/15 dark:text-brand-light font-medium" : "text-stone-600 dark:text-stone-300 hover:bg-stone-200/60 dark:hover:bg-stone-800"
        }`}
      >
        About Lua
      </a>
    </li>
  </ul>
</nav>

<script is:inline>
  (function () {
    try {
      const completed = JSON.parse(localStorage.getItem("lua-course-progress") || "[]");
      completed.forEach((id) => {
        document.querySelector(`[data-lesson-check="${id}"]`)?.classList.remove("hidden");
      });
    } catch {
      // ignore malformed localStorage state
    }
  })();
</script>
